# Optional settings for andante-server. Copy to andante.env and uncomment what you need.
# Every setting is in docs/configuration.md.

# The proxy in front of andante that terminates TLS. Without it, every login looks like it
# came from the proxy, and the throttle treats everyone as one address.
#ANDANTE_TRUSTED_PROXIES=172.16.0.0/12

# Log in with an OpenID provider.
#ANDANTE_OIDC_ISSUER=https://id.example.com
#ANDANTE_OIDC_CLIENT_ID=andante
#ANDANTE_OIDC_CLIENT_SECRET=
#ANDANTE_OIDC_ALLOWED_DOMAIN=example.com

# Turn password logins off once everyone uses the provider.
#ANDANTE_PASSWORD_LOGIN=false
