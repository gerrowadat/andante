# Copy to .env and change all of it. openssl rand -hex 32 makes a fine secret.
POSTGRES_PASSWORD=change-me
CATALOGUE_DB_PASSWORD=change-me-too
# At least 32 characters. Lose this and feed URLs can't be shown again.
ANDANTE_SECRET=change-me-as-well-and-make-it-at-least-32-characters
ANDANTE_CATALOGUE_TOKEN=and-this-one

# Where feed readers will reach this. Feed links are built from it.
ANDANTE_BASE_URL=http://localhost:8080
