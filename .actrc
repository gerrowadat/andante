# Defaults for act, which runs .github/workflows/ locally in containers. See
# docs/development.md.
#
# act's default ubuntu-latest image has no git. The medium catthehacker image is
# the smallest one that works; it is about 1GB and pulled once.
-P ubuntu-latest=catthehacker/ubuntu:act-latest

# Reuse containers so that the module cache and the toolchain survive between
# runs. `make ci-clean` throws them away when they go stale.
--reuse
