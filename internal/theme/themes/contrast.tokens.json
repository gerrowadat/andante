{
  "$description": "Black and white with square corners, for the most contrast.",
  "size": {
    "$type": "dimension",
    "radius": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    }
  },
  "color": {
    "$type": "color",
    "light": {
      "background": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#ffffff"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#ffffff"
        }
      },
      "text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.0,
            0.0
          ],
          "hex": "#000000"
        }
      },
      "muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2,
            0.2,
            0.2
          ],
          "hex": "#333333"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.349,
            0.349,
            0.349
          ],
          "hex": "#595959"
        }
      },
      "primary": {
        "$value": {
          "colorSpace": "srgb",
